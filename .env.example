# ─────────────────────────────────────────────────────────────────────────────
# Affiliate Tool — variáveis de ambiente
#
# Copie para `.env` e preencha. Nada aqui é lido diretamente por process.env:
# tudo passa por src/lib/env.ts (validado com Zod). Ver docs/spec/02-arquitetura.md.
#
# Gerar segredos:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco ────────────────────────────────────────────────────────────────────
# Local: `docker compose up -d db` sobe o Postgres 16 na porta 5432.
DATABASE_URL="postgresql://affiliate:affiliate@localhost:5432/affiliate?schema=public"
# Banco usado pelos testes de integração (`docker compose up -d db_test`, porta 5434).
DATABASE_URL_TEST="postgresql://affiliate:affiliate@localhost:5434/affiliate_test?schema=public"

# ── Aplicação ────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# E-mail do admin que recebe alertas operacionais.
ADMIN_EMAIL="admin@example.com"

# ── Autenticação (Better Auth — fatia 01) ────────────────────────────────────
BETTER_AUTH_SECRET="troque-me-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# ── Criptografia ─────────────────────────────────────────────────────────────
# 32 bytes em base64. Protege chave Pix do afiliado e CPF do comprador (AES-256-GCM).
# Trocar exige rodar scripts/rotate-encryption-key.ts com o app em manutenção.
ENCRYPTION_KEY="troque-me-openssl-rand-base64-32"
# Assina o cookie de atribuição do afiliado (/r/[code]).
REF_COOKIE_SECRET="troque-me-openssl-rand-base64-32"
# Protege as rotas /api/cron/* (header Authorization: Bearer <valor>).
CRON_SECRET="troque-me-openssl-rand-base64-32"

# ── Pagar.me (fatia 05) ──────────────────────────────────────────────────────
# `fake` usa src/server/pagarme/fake.ts — obrigatório em testes e e2e.
PAGARME_DRIVER="fake"
PAGARME_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAGARME_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxx"
# Basic auth que o Pagar.me usa para chamar /api/webhooks/pagarme.
PAGARME_WEBHOOK_USER="affiliate"
PAGARME_WEBHOOK_PASSWORD="troque-me"

# ── E-mail (fatia 01+) ───────────────────────────────────────────────────────
# `log` imprime no console (dev/test), `resend` em produção, `smtp` como alternativa.
MAIL_DRIVER="log"
MAIL_FROM="Affiliate Tool <noreply@mail.example.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ── Arquivos ─────────────────────────────────────────────────────────────────
# Em produção é o volume montado em /data/storage (EasyPanel).
STORAGE_DIR="./storage"

# ── Integrações opcionais (n8n) ──────────────────────────────────────────────
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

# SHA do build (EasyPanel: git SHA como build arg). Aparece em GET /api/health como `version`.
BUILD_SHA=""

# ── Seed ─────────────────────────────────────────────────────────────────────
# Senha do admin criado pelo seed (fatia 01 em diante).
SEED_ADMIN_PASSWORD="mudar-em-producao"
# O seed recusa rodar em produção sem esta flag.
# SEED_FORCE="1"
